# Copy to .env (gitignored). Never put keys in the repo.

# xAI API (paid console key, not SuperGrok)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# SuperGrok via Grok CLI OAuth. No API key.
# npx --yes tsx adapters/grok-cli/login.ts
# npx --yes tsx adapters/grok-cli/login.ts --code PASTE
# Tokens: .grok-oauth.json (gitignored, project dir)
GROK_CLI_BASE_URL=https://cli-chat-proxy.grok.com/v1

# OpenCode Zen Go — OpenAI-compatible chat/completions or /responses.
# Adapter sends User-Agent: catmouse/1.0 and a fresh x-opencode-session per level.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Local llama.cpp. You start it; catmouse does not spawn it.
# llama serve --host 127.0.0.1 --port 4080 -m "D:\\ai\\Qwen3.5-4B-UD-Q4_K_XL.gguf" -c 65536
# -c 8192 is too small for a 20-turn level. 32768 is the floor; 65536 if VRAM allows.
# Provider is hidden until LLAMA_BASE_URL is set.
LLAMA_BASE_URL=

# Roles. Model ids come from GET $BASE_URL/models — do not hardcode a catalogue.
ATTACKER_PROVIDER=grok-cli
ATTACKER_MODEL=
DEFENDER_PROVIDER=opencode
DEFENDER_MODEL=

# Caps. The remaining-turns line is harness-injected, not defender speech.
TURN_LIMIT=20
CONTEXT_LIMIT_TOKENS=128000
MODEL_TIMEOUT_MS=180000

# Delete the model cache on every server start (recommended)
REFRESH_MODELS_ON_START=true
